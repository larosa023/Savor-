<Window x:Class="Savor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Savor" Width="1240" Height="780" MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        Icon="Assets/savor.ico"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="52" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.TaskbarItemInfo>
        <TaskbarItemInfo x:Name="TaskbarInfo"/>
    </Window.TaskbarItemInfo>

    <Window.Resources>
        <!-- red "live" dot shown on the taskbar icon while the replay buffer or a recording is on -->
        <DrawingImage x:Key="LiveOverlay">
            <DrawingImage.Drawing>
                <DrawingGroup>
                    <!-- transparent 16x16 frame so Windows doesn't stretch the dot to fill the badge -->
                    <GeometryDrawing Brush="Transparent">
                        <GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,16,16"/></GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#FF0E0F11">
                        <GeometryDrawing.Geometry><EllipseGeometry Center="8,8" RadiusX="6.5" RadiusY="6.5"/></GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#FFFF3B4E">
                        <GeometryDrawing.Geometry><EllipseGeometry Center="8,8" RadiusX="4.8" RadiusY="4.8"/></GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingImage.Drawing>
        </DrawingImage>
        <Storyboard x:Key="PulseLive" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="BufferDotHalo" Storyboard.TargetProperty="Opacity"
                             From="0.15" To="0.55" Duration="0:0:0.9"/>
        </Storyboard>
        <Storyboard x:Key="PulseRec" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="RecDot" Storyboard.TargetProperty="Opacity"
                             From="1" To="0.35" Duration="0:0:0.7"/>
        </Storyboard>

        <LinearGradientBrush x:Key="MeterBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#34D399" Offset="0"/>
            <GradientStop Color="#34D399" Offset="0.666"/>
            <GradientStop Color="#F5C542" Offset="0.667"/>
            <GradientStop Color="#F5C542" Offset="0.849"/>
            <GradientStop Color="#FF4759" Offset="0.85"/>
            <GradientStop Color="#FF4759" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="NavTab" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="GroupName" Value="Nav"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" CornerRadius="7" Padding="14,5" Background="Transparent">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Surface3Brush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FilterChip" TargetType="RadioButton" BasedOn="{StaticResource NavTab}">
            <Setter Property="GroupName" Value="GameFilter"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <!-- clip card -->
        <DataTemplate x:Key="ClipTemplate">
            <Border x:Name="Card" Width="232" Margin="0,0,14,14" CornerRadius="12" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Cursor="Hand"
                    Tag="{Binding}" MouseLeftButtonUp="ClipCard_Click" ToolTip="{Binding FilePath}">
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="View &amp; edit" Click="ClipOpen_Click"/>
                        <MenuItem Header="Rename" Click="ClipRename_Click"/>
                        <MenuItem Header="Game" SubmenuOpened="ClipGameMenu_Opened">
                            <MenuItem Header="…"/>
                        </MenuItem>
                        <MenuItem Header="Open in default player" Click="ClipExternal_Click"/>
                        <MenuItem Header="Show in folder" Click="ClipReveal_Click"/>
                        <MenuItem Header="Copy file" Click="ClipCopy_Click"/>
                        <MenuItem Header="Delete" Click="ClipDelete_Click"/>
                    </ContextMenu>
                </Border.ContextMenu>
                <StackPanel>
                    <Grid Height="130" Margin="6,6,6,0">
                        <Border CornerRadius="8" Background="{StaticResource Surface2Brush}"/>
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE714;" FontSize="22"
                                   Foreground="{StaticResource FaintBrush}" HorizontalAlignment="Center"/>
                        <Border CornerRadius="8">
                            <Border.Background>
                                <ImageBrush ImageSource="{Binding Thumbnail}" Stretch="UniformToFill"/>
                            </Border.Background>
                        </Border>
                        <Border Style="{StaticResource Chip}" Background="#B3000000" HorizontalAlignment="Left"
                                VerticalAlignment="Top" Margin="8">
                            <TextBlock Text="{Binding Kind}" FontSize="10" FontWeight="Bold" Foreground="White"/>
                        </Border>
                        <Border x:Name="DurationChip" Style="{StaticResource Chip}" Background="#B3000000"
                                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="8">
                            <TextBlock Text="{Binding Duration}" FontSize="11" FontWeight="SemiBold" Foreground="White"/>
                        </Border>
                    </Grid>
                    <StackPanel Margin="12,10,12,12">
                        <Grid>
                            <TextBlock x:Name="NameText" Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBox x:Name="NameBox" Visibility="Collapsed" Style="{StaticResource InlineEdit}" FontWeight="SemiBold" Margin="-6,-3,-6,-3"
                                     Tag="{Binding}" IsVisibleChanged="RenameBox_VisibleChanged" PreviewKeyDown="RenameBox_KeyDown"
                                     LostKeyboardFocus="RenameBox_LostFocus" MouseLeftButtonUp="RenameBox_MouseUp"/>
                        </Grid>
                        <TextBlock Text="{Binding Meta}" Foreground="{StaticResource MutedBrush}" FontSize="11.5" Margin="0,3,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding HasDuration}" Value="False">
                    <Setter TargetName="DurationChip" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsRenaming}" Value="True">
                    <Setter TargetName="NameText" Property="Visibility" Value="Hidden"/>
                    <Setter TargetName="NameBox" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsRecording}" Value="True">
                    <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource LineBrush}"/>
                </DataTrigger>
                <Trigger SourceName="Card" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Card" Property="BorderBrush" Value="#55FF7A45"/>
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- settings row helpers -->
        <Style x:Key="RowTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>
        <Style x:Key="RowDesc" TargetType="TextBlock" BasedOn="{StaticResource Muted}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,2,24,0"/>
        </Style>
        <Style x:Key="Divider" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="{StaticResource LineBrush}"/>
            <Setter Property="Margin" Value="0,14"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource Eyebrow}">
            <Setter Property="Margin" Value="4,22,0,10"/>
        </Style>
        <Style x:Key="HotkeyButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="MinWidth" Value="150"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Padding" Value="12,7"/>
        </Style>
    </Window.Resources>

    <Border x:Name="Root">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ================= title bar ================= -->
            <Grid Grid.Row="0" Margin="20,0,8,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Grid Width="22" Height="22" Margin="0,0,10,0">
                        <Ellipse Fill="{StaticResource AccentBrush}"/>
                        <Ellipse Width="9" Height="9" Fill="{StaticResource BgBrush}"/>
                    </Grid>
                    <TextBlock Text="Savor" FontFamily="{StaticResource DisplayFont}" FontSize="16" FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                            CornerRadius="10" Padding="3" Margin="22,0,0,0" WindowChrome.IsHitTestVisibleInChrome="True">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="StudioTab" Style="{StaticResource NavTab}" Content="Studio" IsChecked="True"
                                         Checked="Tab_Checked"/>
                            <RadioButton x:Name="CapturesTab" Style="{StaticResource NavTab}" Checked="Tab_Checked" Click="CapturesTab_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Captures"/>
                                    <TextBlock x:Name="ClipCount" Foreground="{StaticResource FaintBrush}" Margin="6,0,0,0"/>
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>
                    </Border>
                    <Border x:Name="HeaderRecBadge" Style="{StaticResource Chip}" Background="{StaticResource RecSoftBrush}"
                            Margin="14,0,0,0" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="{StaticResource RecBrush}" Margin="0,0,6,0"/>
                            <TextBlock x:Name="HeaderRecText" Text="REC 00:00" FontSize="11" FontWeight="Bold"
                                       Foreground="{StaticResource RecBrush}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="UpdateButton" Style="{StaticResource PrimaryButton}" Padding="12,5" Margin="0,0,8,0"
                            FontSize="12" Visibility="Collapsed" Click="Update_Click"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE896;" FontSize="12" Margin="0,0,7,0"/>
                            <TextBlock x:Name="UpdateText" Text="Update"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="WhatsNewButton" Style="{StaticResource CaptionButton}" Click="WhatsNew_Click"
                            WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="What's new">
                        <Grid>
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE81C;" FontSize="15"/>
                            <Ellipse x:Name="WhatsNewDot" Width="7" Height="7" Fill="{StaticResource AccentBrush}"
                                     HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-4,0" Visibility="Collapsed"/>
                        </Grid>
                    </Button>
                    <Button x:Name="SettingsButton" Style="{StaticResource CaptionButton}" Click="Settings_Click"
                            WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Settings">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE713;" FontSize="15"/>
                    </Button>
                    <Button Style="{StaticResource CaptionButton}" Click="Minimize_Click"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE921;" FontSize="10"/>
                    </Button>
                    <Button Style="{StaticResource CaptionButton}" Click="Maximize_Click"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                        <TextBlock x:Name="MaximizeIcon" Style="{StaticResource Icon}" Text="&#xE922;" FontSize="10"/>
                    </Button>
                    <Button Style="{StaticResource CloseButton}" Click="Close_Click"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8BB;" FontSize="10"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- what's new panel -->
            <Border x:Name="WhatsNewScrim" Grid.Row="1" Background="#01000000" Visibility="Collapsed" Panel.ZIndex="19"
                    MouseLeftButtonDown="WhatsNewScrim_Click"/>
            <Border x:Name="WhatsNewPanel" Grid.Row="1" Width="400" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,0,20,20" Panel.ZIndex="20" Visibility="Collapsed" CornerRadius="14"
                    Background="{StaticResource Surface2Brush}" BorderBrush="#33353B" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30" ShadowDepth="6" Opacity="0.5" Color="Black"/>
                </Border.Effect>
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="20,16,10,8">
                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Padding="8,6" Click="WhatsNewClose_Click">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE711;" FontSize="11"/>
                        </Button>
                        <StackPanel>
                            <TextBlock Text="What's new" FontFamily="{StaticResource DisplayFont}" FontSize="17" FontWeight="SemiBold"/>
                            <TextBlock x:Name="WhatsNewSub" Foreground="{StaticResource FaintBrush}" FontSize="11.5" Margin="0,2,0,0"/>
                        </StackPanel>
                    </DockPanel>
                    <ScrollViewer x:Name="WhatsNewScroll" VerticalScrollBarVisibility="Auto" MaxHeight="520" Margin="0,0,4,12">
                        <StackPanel x:Name="WhatsNewList" Margin="20,0,16,8"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- error banner (shared) -->
            <Border x:Name="Banner" Grid.Row="1" CornerRadius="10" Background="{StaticResource RecSoftBrush}" VerticalAlignment="Top"
                    BorderBrush="#44FF4759" BorderThickness="1" Padding="14,10" Margin="20,0,20,0" Visibility="Collapsed"
                    Panel.ZIndex="10">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Padding="8,2" Click="DismissBanner_Click">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE711;" FontSize="11"/>
                    </Button>
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE783;" Foreground="{StaticResource RecBrush}" Margin="0,0,10,0"/>
                    <TextBlock x:Name="BannerText" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="#FFC2C8"/>
                </DockPanel>
            </Border>

            <!-- ================= studio ================= -->
            <Grid x:Name="StudioPage" Grid.Row="1" Margin="20,0,20,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="34"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="320"/>
                </Grid.ColumnDefinitions>

                <!-- left: preview + mixer -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" MinHeight="200"/>
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- preview -->
                    <Border x:Name="PreviewFrame" CornerRadius="14" Background="#08090A" BorderBrush="{StaticResource LineBrush}"
                            BorderThickness="1">
                        <Grid>
                            <Border CornerRadius="13" Margin="0">
                                <Border.Background>
                                    <ImageBrush x:Name="PreviewBrush" Stretch="Uniform"/>
                                </Border.Background>
                            </Border>

                            <StackPanel x:Name="PreviewPlaceholder" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE7F4;" FontSize="30" HorizontalAlignment="Center"
                                           Foreground="{StaticResource FaintBrush}"/>
                                <TextBlock x:Name="PreviewPlaceholderText" Text="Starting preview…" HorizontalAlignment="Center"
                                           Margin="0,12,0,0" Foreground="{StaticResource MutedBrush}"/>
                            </StackPanel>

                            <!-- overlays -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12">
                                <Border Style="{StaticResource Chip}" Background="#B30E0F11" Padding="9,4">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse x:Name="PreviewLiveDot" Width="6" Height="6" Fill="{StaticResource FaintBrush}" Margin="0,0,7,0"/>
                                        <TextBlock x:Name="PreviewLabel" Text="Preview" FontSize="11.5" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Border>
                                <Border x:Name="PreviewRecChip" Style="{StaticResource Chip}" Background="#D9FF4759" Padding="9,4"
                                        Margin="8,0,0,0" Visibility="Collapsed">
                                    <TextBlock x:Name="PreviewRecText" Text="REC" FontSize="11.5" FontWeight="Bold" Foreground="White"/>
                                </Border>
                                <Border x:Name="PreviewBufferChip" Style="{StaticResource Chip}" Background="#D934D399" Padding="9,4"
                                        Margin="8,0,0,0" Visibility="Collapsed">
                                    <TextBlock x:Name="PreviewBufferText" Text="REPLAY 1:00" FontSize="11.5" FontWeight="Bold" Foreground="#0B2A1E"/>
                                </Border>
                            </StackPanel>
                            <Button HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10" Style="{StaticResource GhostButton}"
                                    Background="#B30E0F11" Padding="9,6" Click="TogglePreview_Click" ToolTip="Show / hide preview">
                                <TextBlock x:Name="PreviewEyeIcon" Style="{StaticResource Icon}" Text="&#xE7B3;" FontSize="13"
                                           Foreground="{StaticResource TextBrush}"/>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- audio mixer -->
                    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="18,14">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,10">
                                <TextBlock DockPanel.Dock="Right" x:Name="MixerNote" Foreground="{StaticResource FaintBrush}" FontSize="11.5"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="Audio mixer" Style="{StaticResource Eyebrow}"/>
                            </DockPanel>

                            <!-- desktop track -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Desktop audio" FontWeight="SemiBold"/>
                                        <Border x:Name="DeskTrackChip" Style="{StaticResource Chip}" Margin="8,0,0,0" Padding="6,1" Visibility="Collapsed">
                                            <TextBlock x:Name="DeskTrackChipText" FontSize="10" FontWeight="Bold" Foreground="{StaticResource MutedBrush}"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock x:Name="DeskDevice" Foreground="{StaticResource FaintBrush}" FontSize="11"
                                               TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <Grid Height="8">
                                        <Border CornerRadius="3" Background="{StaticResource MeterBrush}"/>
                                        <Border x:Name="DeskMask" CornerRadius="0,3,3,0" Background="#E61E1F23" RenderTransformOrigin="1,0.5">
                                            <Border.RenderTransform><ScaleTransform x:Name="DeskMaskScale" ScaleX="1"/></Border.RenderTransform>
                                        </Border>
                                        <Border x:Name="DeskPeak" Width="2" Background="White" Opacity="0.85" HorizontalAlignment="Left">
                                            <Border.RenderTransform><TranslateTransform x:Name="DeskPeakX" X="0"/></Border.RenderTransform>
                                        </Border>
                                    </Grid>
                                    <Slider x:Name="DeskVol" Minimum="0" Maximum="200" Margin="0,4,0,0" ValueChanged="TrackVolume_Changed"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                    <TextBlock x:Name="DeskDb" Width="62" TextAlignment="Right" FontSize="12"
                                               Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                                    <Button x:Name="DeskMute" Style="{StaticResource GhostButton}" Padding="9,6" Margin="6,0,0,0"
                                            Click="DeskMute_Click" ToolTip="Mute desktop audio">
                                        <TextBlock x:Name="DeskMuteIcon" Style="{StaticResource Icon}" Text="&#xE767;" FontSize="14"/>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!-- mic track -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Microphone" FontWeight="SemiBold"/>
                                        <Border x:Name="MicTrackChip" Style="{StaticResource Chip}" Margin="8,0,0,0" Padding="6,1" Visibility="Collapsed">
                                            <TextBlock x:Name="MicTrackChipText" FontSize="10" FontWeight="Bold" Foreground="{StaticResource MutedBrush}"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock x:Name="MicDevice" Foreground="{StaticResource FaintBrush}" FontSize="11"
                                               TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <Grid Height="8">
                                        <Border CornerRadius="3" Background="{StaticResource MeterBrush}"/>
                                        <Border x:Name="MicMask" CornerRadius="0,3,3,0" Background="#E61E1F23" RenderTransformOrigin="1,0.5">
                                            <Border.RenderTransform><ScaleTransform x:Name="MicMaskScale" ScaleX="1"/></Border.RenderTransform>
                                        </Border>
                                        <Border x:Name="MicPeak" Width="2" Background="White" Opacity="0.85" HorizontalAlignment="Left">
                                            <Border.RenderTransform><TranslateTransform x:Name="MicPeakX" X="0"/></Border.RenderTransform>
                                        </Border>
                                    </Grid>
                                    <Slider x:Name="MicVol" Minimum="0" Maximum="200" Margin="0,4,0,0" ValueChanged="TrackVolume_Changed"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                    <TextBlock x:Name="MicDb" Width="62" TextAlignment="Right" FontSize="12"
                                               Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                                    <Button x:Name="MicMute" Style="{StaticResource GhostButton}" Padding="9,6" Margin="6,0,0,0"
                                            Click="MicMute_Click" ToolTip="Mute microphone">
                                        <TextBlock x:Name="MicMuteIcon" Style="{StaticResource Icon}" Text="&#xE720;" FontSize="14"/>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!-- one row per app with its own track (built in code) -->
                            <StackPanel x:Name="AppRows"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- right: controls + sources -->
                <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <!-- replay buffer -->
                        <Border Style="{StaticResource Card}" Padding="18,16">
                            <StackPanel>
                                <DockPanel>
                                    <CheckBox x:Name="BufferToggle" DockPanel.Dock="Right" Style="{StaticResource Switch}"
                                              Click="BufferToggle_Click" VerticalAlignment="Top"/>
                                    <StackPanel>
                                        <TextBlock Text="Replay buffer" Style="{StaticResource Eyebrow}"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                            <Grid Width="12" Height="12" Margin="0,0,9,0" VerticalAlignment="Center">
                                                <Ellipse x:Name="BufferDotHalo" Fill="{StaticResource LiveBrush}" Opacity="0"/>
                                                <Ellipse x:Name="BufferDot" Width="7" Height="7" Fill="{StaticResource FaintBrush}"/>
                                            </Grid>
                                            <TextBlock x:Name="BufferStatus" Text="Off" FontFamily="{StaticResource DisplayFont}"
                                                       FontSize="20" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </StackPanel>
                                </DockPanel>
                                <TextBlock x:Name="BufferHint" Style="{StaticResource Muted}" Margin="0,8,0,14" FontSize="12"
                                           Text="Keeps the last minute of your screen ready to save as a clip."/>
                                <Button x:Name="SaveClipButton" Style="{StaticResource PrimaryButton}"
                                        HorizontalContentAlignment="Stretch" Click="SaveClip_Click" IsEnabled="False" Padding="14,10">
                                    <DockPanel>
                                        <Border DockPanel.Dock="Right" CornerRadius="5" Background="#26000000" Padding="7,2">
                                            <TextBlock x:Name="SaveClipHotkeyText" Text="Alt + F10" FontSize="11.5" FontWeight="SemiBold"/>
                                        </Border>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE74E;" Margin="0,0,10,0"/>
                                            <TextBlock x:Name="SaveClipText" Text="Save clip" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- recording -->
                        <Border Style="{StaticResource Card}" Padding="18,16" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="Recording" Style="{StaticResource Eyebrow}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <Grid Width="12" Height="12" Margin="0,0,9,0" VerticalAlignment="Center">
                                        <Ellipse x:Name="RecDot" Width="7" Height="7" Fill="{StaticResource FaintBrush}"/>
                                    </Grid>
                                    <TextBlock x:Name="RecTimer" Text="00:00:00" FontFamily="{StaticResource DisplayFont}"
                                               FontSize="20" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular"/>
                                </StackPanel>
                                <TextBlock x:Name="RecHint" Style="{StaticResource Muted}" Margin="0,8,0,14" FontSize="12"
                                           Text="Records until you stop. Shares the encoder with the replay buffer."/>
                                <Button x:Name="RecordButton" Style="{StaticResource RecordButton}"
                                        HorizontalContentAlignment="Stretch" Click="Record_Click" Padding="14,10">
                                    <DockPanel>
                                        <Border DockPanel.Dock="Right" CornerRadius="5" Background="#22FF4759" Padding="7,2">
                                            <TextBlock x:Name="RecordHotkeyText" Text="Alt + F9" FontSize="11.5" FontWeight="SemiBold"/>
                                        </Border>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="RecordIcon" Style="{StaticResource Icon}" Text="&#xE7C8;" Margin="0,0,10,0"/>
                                            <TextBlock x:Name="RecordText" Text="Start recording" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- sources -->
                        <Border Style="{StaticResource Card}" Padding="18,16" Margin="0,14,0,14">
                            <StackPanel>
                                <TextBlock Text="Sources" Style="{StaticResource Eyebrow}" Margin="0,0,0,12"/>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE7F4;" Foreground="{StaticResource MutedBrush}" Margin="0,0,8,0"/>
                                    <TextBlock Text="Display" FontWeight="SemiBold"/>
                                </StackPanel>
                                <ComboBox x:Name="SourceDisplayCombo" MinWidth="0" SelectionChanged="Source_Changed"/>
                                <DockPanel Margin="0,10,0,0">
                                    <CheckBox x:Name="SourceCursorToggle" DockPanel.Dock="Right" Style="{StaticResource Switch}" Click="Source_Changed"/>
                                    <TextBlock Text="Show mouse cursor" Foreground="{StaticResource MutedBrush}" FontSize="12.5" VerticalAlignment="Center"/>
                                </DockPanel>

                                <Border Style="{StaticResource Divider}"/>

                                <DockPanel Margin="0,0,0,6">
                                    <CheckBox x:Name="SourceDesktopToggle" DockPanel.Dock="Right" Style="{StaticResource Switch}" Click="Source_Changed"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE767;" Foreground="{StaticResource MutedBrush}" Margin="0,0,8,0"/>
                                        <TextBlock Text="Desktop audio" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </DockPanel>
                                <TextBlock x:Name="SourceDesktopDevice" Foreground="{StaticResource FaintBrush}" FontSize="11.5"
                                           TextTrimming="CharacterEllipsis"/>

                                <Border Style="{StaticResource Divider}"/>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE720;" Foreground="{StaticResource MutedBrush}" Margin="0,0,8,0"/>
                                    <TextBlock Text="Microphone" FontWeight="SemiBold"/>
                                </StackPanel>
                                <ComboBox x:Name="SourceMicCombo" MinWidth="0" SelectionChanged="Source_Changed"/>
                                <Border Style="{StaticResource Divider}"/>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Padding="8,4" Content="Manage"
                                            Click="ManageApps_Click"/>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8A9;" Foreground="{StaticResource MutedBrush}" Margin="0,0,8,0"/>
                                        <TextBlock Text="App audio" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </DockPanel>
                                <TextBlock x:Name="SourceAppsText" Foreground="{StaticResource FaintBrush}" FontSize="11.5"
                                           TextWrapping="Wrap" Margin="0,4,0,0"/>
                                <TextBlock x:Name="SourceNote" Foreground="{StaticResource AccentBrush}" FontSize="11.5" Margin="0,10,0,0"
                                           TextWrapping="Wrap" Visibility="Collapsed"
                                           Text="Changes apply when the current recording stops."/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- status bar -->
                <DockPanel Grid.Row="1" Grid.ColumnSpan="3" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusRight" DockPanel.Dock="Right" Foreground="{StaticResource FaintBrush}" FontSize="11.5"/>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="StatusDot" Width="6" Height="6" Fill="{StaticResource FaintBrush}" Margin="2,0,8,0"
                                 VerticalAlignment="Center"/>
                        <TextBlock x:Name="CaptureInfo" Foreground="{StaticResource MutedBrush}" FontSize="11.5"
                                   Text="Detecting encoders…" VerticalAlignment="Center"/>
                    </StackPanel>
                </DockPanel>
            </Grid>

            <!-- ================= clip editor ================= -->
            <Grid x:Name="EditorPage" Grid.Row="1" Margin="20,0,20,16" Visibility="Collapsed"/>

            <!-- ================= captures ================= -->
            <Grid x:Name="CapturesPage" Grid.Row="1" Margin="24,0,24,0" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel Margin="2,6,0,14">
                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Click="OpenFolder_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE8B7;" FontSize="13" Margin="0,0,8,0"/>
                            <TextBlock Text="Open folder"/>
                        </StackPanel>
                    </Button>
                    <TextBlock Text="Captures" FontFamily="{StaticResource DisplayFont}" FontSize="20"
                               FontWeight="SemiBold" VerticalAlignment="Center"/>
                </DockPanel>
                <!-- one chip per game, shown once captures have games -->
                <WrapPanel x:Name="GameFilters" Grid.Row="1" Margin="0,-4,0,10" Visibility="Collapsed"/>
                <Grid Grid.Row="2">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,-10,0">
                        <ItemsControl x:Name="ClipList" ItemTemplate="{StaticResource ClipTemplate}" Margin="0,0,0,10">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>
                    <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,40">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8B2;" FontSize="28" HorizontalAlignment="Center"
                                   Foreground="{StaticResource FaintBrush}"/>
                        <TextBlock Text="Nothing captured yet" HorizontalAlignment="Center" Margin="0,12,0,4" FontWeight="SemiBold"/>
                        <TextBlock x:Name="EmptyHint" Text="Turn on the replay buffer, then press Alt + F10 to save a clip."
                                   HorizontalAlignment="Center" Foreground="{StaticResource MutedBrush}" FontSize="12.5"/>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- ================= settings ================= -->
            <Grid x:Name="SettingsPage" Grid.Row="1" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="24,4,24,28" MaxWidth="760">
                        <DockPanel>
                            <Button Style="{StaticResource GhostButton}" Click="Back_Click" Padding="8,6" Margin="-8,0,8,0">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE72B;" FontSize="14" Foreground="{StaticResource TextBrush}"/>
                            </Button>
                            <TextBlock Text="Settings" FontFamily="{StaticResource DisplayFont}" FontSize="22"
                                       FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </DockPanel>
                        <Border x:Name="ApplyNote" CornerRadius="8" Background="{StaticResource AccentSoftBrush}" Padding="12,8"
                                Margin="0,14,0,0" Visibility="Collapsed">
                            <TextBlock Text="Capture changes will apply when the current recording stops."
                                       Foreground="{StaticResource AccentBrush}" FontSize="12.5"/>
                        </Border>

                        <!-- capture -->
                        <TextBlock Text="Capture" Style="{StaticResource SectionTitle}"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <DockPanel>
                                    <ComboBox x:Name="DisplayCombo" DockPanel.Dock="Right" SelectionChanged="Capture_Changed"/>
                                    <StackPanel>
                                        <TextBlock Text="Display" Style="{StaticResource RowTitle}"/>
                                        <TextBlock Text="Which monitor to capture." Style="{StaticResource RowDesc}"/>
                                    </StackPanel>
                                </DockPanel>
                                <Border Style="{StaticResource Divider}"/>
                                <DockPanel>
                                    <ComboBox x:Name="FpsCombo" DockPanel.Dock="Right" SelectionChanged="Capture_Changed"/>
                                    <StackPanel>
                                        <TextBlock Text="Frame rate" Style="{StaticResource RowTitle}"/>
                                        <TextBlock Text="Higher looks smoother but makes bigger files." Style="{StaticResource RowDesc}"/>
                                    </StackPanel>
                                </DockPanel>
                                <Border Style="{StaticResource Divider}"/>
                                <DockPanel>
                                    <ComboBox x:Name="ResolutionCombo" DockPanel.Dock="Right" SelectionChanged="Capture_Changed" MinWidth="190"/>
                                    <StackPanel>
                                        <TextBlock Text="Resolution" Style="{StaticResource RowTitle}"/>
                                        <TextBlock x:Name="ResolutionDesc" Text="Lower makes smaller files and is lighter on your PC." Style="{StaticResource RowDesc}"/>
                                    </StackPanel>
                                </DockPanel>
                                <Border Style="{StaticResource Divider}"/>
                                <DockPanel>
                                    <ComboBox x:Name="QualityCombo" DockPanel.Dock="Right" SelectionChanged="Capture_Changed"/>
                                    <StackPanel>
                                        <TextBlock Text="Quality" Style="{StaticResource RowTitle}"/>
                                        <TextBlock Text="Constant-quality encoding; file size follows how busy the screen is." Style="{StaticResource RowDesc}"/>
                                    </StackPanel>
                                </DockPanel>
                                <Border Style="{StaticResource Divider}"/>
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <Button Style="{StaticResource GhostButton}" Click="Redetect_Click" Margin="0,0,6,0"
                                                ToolTip="Test encoders again">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="13"/>
                                        </Button>
                                        <ComboBox x:Name="EncoderCombo" SelectionChanged="Capture_Changed"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Encoder" Style="{StaticResource RowTitle}"/>
                                        <TextBlock x:Name="EncoderDesc" Text="GPU encoders keep games running smoothly." Style="{StaticResource RowDesc}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </DockPanel>
                                <Border Style="{StaticResource Divider}"/>
                                <DockPanel>
                                    <CheckBox x:Name="CursorToggle" DockPanel.Dock="Right" Style="{StaticResource Switch}" Click="Capture_Changed"/>
                                    <StackPanel>
                                        <TextBlock Text="Capture mouse cursor" Style="{StaticResource RowTitle}"/>
                                    </StackPanel>
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <!-- replay buffer -->
                        <TextBlock Text="Replay buffer" Style="{StaticResource SectionTitle}"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Slider x:Name="ReplaySlider" Width="200" Minimum="10" Maximum="600" SmallChange="5"
                                                LargeChange="30" TickFrequency="5" IsSnapToTickEnabled="True"
                                                ValueChanged="ReplaySlider_Changed"/>
                                        <TextBlock x:Name="ReplayValue" Width="64" TextAlignment="Right" FontWeight="SemiBold"
                                                   VerticalAlignment="Center" Text="1:00"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Clip length" Style="{StaticResource RowTitle}"/>
                                        <TextBlock Text="How far back a saved clip reaches." Style="{StaticResource RowDesc}"/>
                                    </StackPanel>
                                </DockPanel>
                                <Border Style="{StaticResource Divider}"/>
                                <DockPanel>
                                    <CheckBox x:Name="AutoBufferToggle" DockPanel.Dock="Right" Style="{StaticResource Switch}" Click="General_Changed"/>
                                    <StackPanel>
                                        <TextBlock Text="Start replay buffer when Savor opens" Style="{StaticResource RowTitle}"/>
                                    </StackPanel>
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <!-- audio -->
                        <TextBlock Text="Audio" Style="{StaticResource SectionTitle}"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <DockPanel>
                                    <CheckBox x:Name="DesktopAudioToggle" DockPanel.Dock="Right" Style="{StaticResource Switch}" Click="Capture_Changed"/>
                                    <StackPanel>
                                        <TextBlock Text="Desktop audio" Style="{StaticResource RowTitle}"/>
                                        <TextBlock Text="Everything playing through your default speakers or headset." Style="{StaticResource RowDesc}"/>
                                    </StackPanel>
                                </DockPanel>
                                <Border Style="{StaticResource Divider}"/>
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <Slider x:Name="DesktopVolumeSlider" Width="200" Minimum="0" Maximum="200"
                                                ValueChanged="Volume_Changed"/>
                                        <TextBlock x:Name="DesktopVolumeValue" Width="64" TextAlignment="Right" FontWeight="SemiBold"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="Desktop volume" Style="{StaticResource RowTitle}" VerticalAlignment="Center"/>
                                </DockPanel>
                                <Border Style="{StaticResource Divider}"/>
                                <DockPanel>
                                    <ComboBox x:Name="MicCombo" DockPanel.Dock="Right" SelectionChanged="Capture_Changed" MinWidth="260"/>
                                    <StackPanel>
                                        <TextBlock Text="Microphone" Style="{StaticResource RowTitle}"/>
                                        <TextBlock Text="Mixed into the same audio track." Style="{StaticResource RowDesc}"/>
                                    </StackPanel>
                                </DockPanel>
                                <Border Style="{StaticResource Divider}"/>
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <Slider x:Name="MicVolumeSlider" Width="200" Minimum="0" Maximum="200"
                                                ValueChanged="Volume_Changed"/>
                                        <TextBlock x:Name="MicVolumeValue" Width="64" TextAlignment="Right" FontWeight="SemiBold"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="Microphone volume" Style="{StaticResource RowTitle}" VerticalAlignment="Center"/>
                                </DockPanel>
                                <Border Style="{StaticResource Divider}"/>
                                <DockPanel>
                                    <CheckBox x:Name="SeparateTracksToggle" DockPanel.Dock="Right" Style="{StaticResource Switch}" Click="Capture_Changed"/>
                                    <StackPanel>
                                        <TextBlock Text="Separate audio tracks" Style="{StaticResource RowTitle}"/>
                                        <TextBlock Style="{StaticResource RowDesc}"
                                                   Text="Track 1 is everything mixed (what players and Discord play). Then desktop audio, your mic, and each app below get their own tracks, so you can fix levels or cut things out when editing."/>
                                    </StackPanel>
                                </DockPanel>
                                <Border Style="{StaticResource Divider}"/>
                                <StackPanel x:Name="AppTracksSection">
                                    <DockPanel>
                                        <ComboBox x:Name="AddAppCombo" DockPanel.Dock="Right" MinWidth="240"
                                                  DropDownOpened="AddAppCombo_Opened" SelectionChanged="AddAppCombo_Changed"/>
                                        <StackPanel>
                                            <TextBlock Text="App audio tracks" Style="{StaticResource RowTitle}"/>
                                            <TextBlock x:Name="AppTracksDesc" Style="{StaticResource RowDesc}"
                                                       Text="Give apps like your game, Discord or Spotify their own track. Desktop audio still records everything; leave this empty to keep just desktop audio."/>
                                        </StackPanel>
                                    </DockPanel>
                                    <StackPanel x:Name="AppTracksList" Margin="0,10,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- output -->
                        <TextBlock Text="Output" Style="{StaticResource SectionTitle}"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource BaseButton}" Content="Browse…"
                                            Click="Browse_Click" Margin="10,0,0,0" FontWeight="Normal"/>
                                    <StackPanel>
                                        <TextBlock Text="Save captures to" Style="{StaticResource RowTitle}"/>
                                        <TextBlock x:Name="OutputFolderText" Style="{StaticResource RowDesc}" TextTrimming="CharacterEllipsis"
                                                   TextWrapping="NoWrap"/>
                                    </StackPanel>
                                </DockPanel>
                                <Border Style="{StaticResource Divider}"/>
                                <DockPanel>
                                    <ComboBox x:Name="ContainerCombo" DockPanel.Dock="Right" SelectionChanged="General_Changed"/>
                                    <StackPanel>
                                        <TextBlock Text="File format" Style="{StaticResource RowTitle}"/>
                                        <TextBlock Text="MP4 plays everywhere. MKV is friendlier to video editors." Style="{StaticResource RowDesc}"/>
                                    </StackPanel>
                                </DockPanel>
                                <Border Style="{StaticResource Divider}"/>
                                <DockPanel>
                                    <ComboBox x:Name="StorageCombo" DockPanel.Dock="Right" SelectionChanged="Storage_Changed"/>
                                    <StackPanel>
                                        <TextBlock Text="Storage limit" Style="{StaticResource RowTitle}"/>
                                        <TextBlock x:Name="StorageDesc" Style="{StaticResource RowDesc}"
                                                   Text="When Savor's captures go over the limit, the oldest are deleted permanently."/>
                                    </StackPanel>
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <!-- hotkeys -->
                        <TextBlock Text="Hotkeys" Style="{StaticResource SectionTitle}"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <Button Style="{StaticResource GhostButton}" Padding="9,6" Margin="0,0,6,0" Tag="save"
                                                Click="HotkeyClear_Click" ToolTip="Remove this shortcut">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE711;" FontSize="11"/>
                                        </Button>
                                        <Button x:Name="SaveClipHotkeyButton" Style="{StaticResource HotkeyButton}"
                                            Tag="save" Click="Hotkey_Click" PreviewKeyDown="Hotkey_KeyDown" PreviewKeyUp="Hotkey_KeyUp" PreviewMouseDown="Hotkey_MouseDown" LostFocus="Hotkey_LostFocus"/>
                                    </StackPanel>
                                    <TextBlock Text="Save clip" Style="{StaticResource RowTitle}" VerticalAlignment="Center"/>
                                </DockPanel>
                                <Border Style="{StaticResource Divider}"/>
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <Button Style="{StaticResource GhostButton}" Padding="9,6" Margin="0,0,6,0" Tag="record"
                                                Click="HotkeyClear_Click" ToolTip="Remove this shortcut">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE711;" FontSize="11"/>
                                        </Button>
                                        <Button x:Name="RecordHotkeyButton" Style="{StaticResource HotkeyButton}"
                                            Tag="record" Click="Hotkey_Click" PreviewKeyDown="Hotkey_KeyDown" PreviewKeyUp="Hotkey_KeyUp" PreviewMouseDown="Hotkey_MouseDown" LostFocus="Hotkey_LostFocus"/>
                                    </StackPanel>
                                    <TextBlock Text="Start / stop recording" Style="{StaticResource RowTitle}" VerticalAlignment="Center"/>
                                </DockPanel>
                                <Border Style="{StaticResource Divider}"/>
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <Button Style="{StaticResource GhostButton}" Padding="9,6" Margin="0,0,6,0" Tag="buffer"
                                                Click="HotkeyClear_Click" ToolTip="Remove this shortcut">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE711;" FontSize="11"/>
                                        </Button>
                                        <Button x:Name="BufferHotkeyButton" Style="{StaticResource HotkeyButton}"
                                            Tag="buffer" Click="Hotkey_Click" PreviewKeyDown="Hotkey_KeyDown" PreviewKeyUp="Hotkey_KeyUp" PreviewMouseDown="Hotkey_MouseDown" LostFocus="Hotkey_LostFocus"/>
                                    </StackPanel>
                                    <TextBlock Text="Turn replay buffer on / off" Style="{StaticResource RowTitle}" VerticalAlignment="Center"/>
                                </DockPanel>
                                <TextBlock x:Name="HotkeyNote" Style="{StaticResource RowDesc}" Margin="0,14,0,0"
                                           Text="Click a shortcut, then press any key or combo — even Delete, a lone Ctrl, or mouse 4/5. Esc cancels, × removes it."/>
                            </StackPanel>
                        </Border>

                        <!-- general -->
                        <TextBlock Text="General" Style="{StaticResource SectionTitle}"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <DockPanel>
                                    <CheckBox x:Name="StartupToggle" DockPanel.Dock="Right" Style="{StaticResource Switch}" Click="General_Changed"/>
                                    <StackPanel>
                                        <TextBlock Text="Launch when Windows starts" Style="{StaticResource RowTitle}"/>
                                        <TextBlock Text="Starts quietly in the tray." Style="{StaticResource RowDesc}"/>
                                    </StackPanel>
                                </DockPanel>
                                <Border Style="{StaticResource Divider}"/>
                                <DockPanel>
                                    <CheckBox x:Name="TrayToggle" DockPanel.Dock="Right" Style="{StaticResource Switch}" Click="General_Changed"/>
                                    <StackPanel>
                                        <TextBlock Text="Keep running in the tray when closed" Style="{StaticResource RowTitle}"/>
                                        <TextBlock Text="So hotkeys keep working after you close the window." Style="{StaticResource RowDesc}"/>
                                    </StackPanel>
                                </DockPanel>
                                <Border Style="{StaticResource Divider}"/>
                                <DockPanel>
                                    <CheckBox x:Name="NotifyToggle" DockPanel.Dock="Right" Style="{StaticResource Switch}" Click="General_Changed"/>
                                    <StackPanel>
                                        <TextBlock Text="Show a notification when a capture is saved" Style="{StaticResource RowTitle}"/>
                                    </StackPanel>
                                </DockPanel>
                                <Border Style="{StaticResource Divider}"/>
                                <DockPanel>
                                    <CheckBox x:Name="SoundToggle" DockPanel.Dock="Right" Style="{StaticResource Switch}" Click="General_Changed"/>
                                    <StackPanel>
                                        <TextBlock Text="Play a sound when a capture is saved" Style="{StaticResource RowTitle}"/>
                                        <TextBlock Text="A short, quiet chime, so you know a clip saved without looking away from your game." Style="{StaticResource RowDesc}"/>
                                    </StackPanel>
                                </DockPanel>
                                <StackPanel x:Name="SoundVolumeRow">
                                    <Border Style="{StaticResource Divider}"/>
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                            <Slider x:Name="SoundVolumeSlider" Width="200" Minimum="0" Maximum="100"
                                                    SmallChange="5" LargeChange="10" TickFrequency="5" IsSnapToTickEnabled="True"
                                                    ValueChanged="SoundVolume_Changed"/>
                                            <TextBlock x:Name="SoundVolumeValue" Width="64" TextAlignment="Right" FontWeight="SemiBold"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Sound volume" Style="{StaticResource RowTitle}"/>
                                            <TextBlock Text="Plays a preview when you let go." Style="{StaticResource RowDesc}"/>
                                        </StackPanel>
                                    </DockPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="About" Style="{StaticResource SectionTitle}"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                            <DockPanel>
                                <Button x:Name="CheckUpdatesButton" DockPanel.Dock="Right" Style="{StaticResource BaseButton}"
                                        Content="Check for updates" FontWeight="Normal" Click="CheckUpdates_Click"/>
                                <StackPanel>
                                    <TextBlock x:Name="VersionText" Text="Savor" Style="{StaticResource RowTitle}"/>
                                    <TextBlock x:Name="UpdateStatusText" Style="{StaticResource RowDesc}"
                                               Text="Savor checks for updates automatically and shows an Update button when one is ready."/>
                                </StackPanel>
                            </DockPanel>
                                <Border Style="{StaticResource Divider}"/>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource BaseButton}" FontWeight="Normal" Click="CopyDiagnostics_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE8C8;" FontSize="12" Margin="0,0,8,0"/>
                                            <TextBlock x:Name="DiagButtonText" Text="Copy diagnostics"/>
                                        </StackPanel>
                                    </Button>
                                    <StackPanel>
                                        <TextBlock Text="Having a problem?" Style="{StaticResource RowTitle}"/>
                                        <TextBlock Text="Copies your Savor version, graphics card, encoder and recent errors, so you can paste them to whoever is helping." Style="{StaticResource RowDesc}"/>
                                    </StackPanel>
                                </DockPanel>
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="AboutText" Style="{StaticResource Muted}" FontSize="11.5" Margin="4,14,0,0"
                                   Foreground="{StaticResource FaintBrush}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Border>
</Window>
