<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Savor</AssemblyName>
    <RootNamespace>Savor</RootNamespace>
    <ApplicationIcon>Assets\savor.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.5.3</Version>
    <Product>Savor</Product>
    <Description>Lightweight screen recorder with a replay buffer</Description>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- memory: a single non-concurrent GC that gives memory back eagerly.
         (InvariantGlobalization is NOT used: WPF dropdowns need real culture data.) -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>false</TieredPGO>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
  </ItemGroup>

  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="7" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\savor.ico" />
  </ItemGroup>

  <!-- compiled by CI with fxc (ps_2_0) from Shaders/ExpandRange.hlsl -->
  <ItemGroup Condition="Exists('Shaders\ExpandRange.ps')">
    <Resource Include="Shaders\ExpandRange.ps" />
  </ItemGroup>

  <!-- CI drops a gzipped ffmpeg.exe here so Savor.exe ships as a single file. -->
  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)..\..\ffmpeg\ffmpeg.exe.gz')">
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)..\..\ffmpeg\ffmpeg.exe.gz" LogicalName="ffmpeg.exe.gz" />
  </ItemGroup>

</Project>
