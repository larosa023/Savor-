<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Savor</AssemblyName>
    <RootNamespace>Savor</RootNamespace>
    <ApplicationIcon>Assets\savor.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.1.3</Version>
    <Product>Savor</Product>
    <Description>Lightweight screen recorder with a replay buffer</Description>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\savor.ico" />
  </ItemGroup>

  <!-- CI drops a gzipped ffmpeg.exe here so Savor.exe ships as a single file. -->
  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)..\..\ffmpeg\ffmpeg.exe.gz')">
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)..\..\ffmpeg\ffmpeg.exe.gz" LogicalName="ffmpeg.exe.gz" />
  </ItemGroup>

</Project>
