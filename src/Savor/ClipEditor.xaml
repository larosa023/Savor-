<UserControl x:Class="Savor.ClipEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True" FocusVisualStyle="{x:Null}" Background="Transparent">
    <UserControl.Resources>
        <Style x:Key="ToolButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Padding" Value="9,7"/>
        </Style>
        <Style x:Key="Seg" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" CornerRadius="7" Padding="10,6" Background="Transparent" Margin="0,0,4,4"
                                BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SegToggle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" CornerRadius="7" Padding="10,6" Background="Transparent" Margin="0,0,4,4"
                                BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="290"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- header -->
        <DockPanel Grid.ColumnSpan="3" Margin="0,4,0,12">
            <Button Style="{StaticResource GhostButton}" Click="Back_Click" Padding="8,6" Margin="-8,0,6,0" ToolTip="Back to captures (Esc)">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE72B;" FontSize="14" Foreground="{StaticResource TextBrush}"/>
            </Button>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Style="{StaticResource GhostButton}" Click="OpenExternal_Click" ToolTip="Open in your default player">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8A7;" FontSize="12" Margin="0,0,7,0"/>
                        <TextBlock Text="Open externally"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource GhostButton}" Click="Reveal_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8B7;" FontSize="12" Margin="0,0,7,0"/>
                        <TextBlock Text="Show in folder"/>
                    </StackPanel>
                </Button>
            </StackPanel>
            <StackPanel VerticalAlignment="Center">
                <TextBox x:Name="TitleText" Style="{StaticResource InlineEdit}" FontFamily="{StaticResource DisplayFont}" FontSize="17"
                         FontWeight="SemiBold" Margin="-6,-3,0,-3" HorizontalAlignment="Left" MinWidth="120" MaxWidth="560"
                         ToolTip="Click to rename" PreviewKeyDown="Title_KeyDown" LostKeyboardFocus="Title_LostFocus"/>
                <TextBlock x:Name="MetaText" Foreground="{StaticResource FaintBrush}" FontSize="11.5" Margin="0,1,0,0"/>
            </StackPanel>
        </DockPanel>

        <!-- ============ player ============ -->
        <Border Grid.Row="1" CornerRadius="14" Background="#050506" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                ClipToBounds="True">
            <Grid x:Name="Stage" SizeChanged="Stage_SizeChanged" Background="Transparent" MouseLeftButtonDown="Stage_Click">
                <MediaElement x:Name="Player" LoadedBehavior="Manual" UnloadedBehavior="Close" ScrubbingEnabled="True"
                              Stretch="Uniform" MediaOpened="Player_MediaOpened" MediaFailed="Player_MediaFailed"
                              MediaEnded="Player_MediaEnded" IsHitTestVisible="False"/>

                <!-- shown instead of seeking the video while dragging the timeline -->
                <Image x:Name="ScrubFrame" Stretch="Uniform" Visibility="Collapsed" IsHitTestVisible="False"
                       RenderOptions.BitmapScalingMode="HighQuality"/>

                <!-- crop overlay -->
                <Canvas x:Name="CropLayer" Visibility="Collapsed" Background="Transparent"
                        MouseLeftButtonDown="Crop_MouseDown" MouseMove="Crop_MouseMove" MouseLeftButtonUp="Crop_MouseUp">
                    <Path x:Name="CropShade" Fill="#B3000000" IsHitTestVisible="False"/>
                    <Rectangle x:Name="CropBox" Stroke="{StaticResource AccentBrush}" StrokeThickness="2" IsHitTestVisible="False"/>
                    <Rectangle x:Name="CropThirdsV" Stroke="#55FFFFFF" StrokeThickness="1" IsHitTestVisible="False"/>
                    <Rectangle x:Name="CropThirdsH" Stroke="#55FFFFFF" StrokeThickness="1" IsHitTestVisible="False"/>
                    <Rectangle x:Name="HandleTL" Width="12" Height="12" Fill="{StaticResource AccentBrush}" IsHitTestVisible="False" RadiusX="2" RadiusY="2"/>
                    <Rectangle x:Name="HandleTR" Width="12" Height="12" Fill="{StaticResource AccentBrush}" IsHitTestVisible="False" RadiusX="2" RadiusY="2"/>
                    <Rectangle x:Name="HandleBL" Width="12" Height="12" Fill="{StaticResource AccentBrush}" IsHitTestVisible="False" RadiusX="2" RadiusY="2"/>
                    <Rectangle x:Name="HandleBR" Width="12" Height="12" Fill="{StaticResource AccentBrush}" IsHitTestVisible="False" RadiusX="2" RadiusY="2"/>
                    <Border x:Name="CropSizeChip" Style="{StaticResource Chip}" Background="#D90E0F11" IsHitTestVisible="False">
                        <TextBlock x:Name="CropSizeText" FontSize="11" FontWeight="SemiBold"/>
                    </Border>
                </Canvas>

                <StackPanel x:Name="PlayerMessage" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"
                            MaxWidth="420">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE783;" FontSize="26" HorizontalAlignment="Center"
                               Foreground="{StaticResource FaintBrush}"/>
                    <TextBlock x:Name="PlayerMessageText" TextAlignment="Center" TextWrapping="Wrap" Margin="0,10,0,0"
                               Foreground="{StaticResource MutedBrush}"/>
                </StackPanel>

                <Border x:Name="BigPlay" Width="64" Height="64" CornerRadius="32" Background="#99000000"
                        HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xF5B0;" FontSize="24" Foreground="White"
                               HorizontalAlignment="Center" Margin="4,0,0,0"/>
                </Border>
            </Grid>
        </Border>

        <!-- ============ transport + timeline ============ -->
        <StackPanel Grid.Row="2" Margin="0,14,0,0">
            <!-- timeline -->
            <Grid x:Name="Timeline" Height="44" Background="Transparent"
                  MouseLeftButtonDown="Timeline_MouseDown" MouseMove="Timeline_MouseMove" MouseLeftButtonUp="Timeline_MouseUp"
                  LostMouseCapture="Timeline_LostCapture" SizeChanged="Timeline_SizeChanged">
                <Border CornerRadius="6" Background="{StaticResource Surface2Brush}" Height="28" VerticalAlignment="Center"
                        Margin="18,0"/>
                <Canvas x:Name="TimelineCanvas" IsHitTestVisible="False" ClipToBounds="False">
                    <Border x:Name="SelBand" Height="28" Canvas.Top="8" Width="100" Background="{StaticResource AccentSoftBrush}"
                            BorderBrush="{StaticResource AccentBrush}" BorderThickness="0,2" RenderTransformOrigin="0,0">
                        <Border.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="SelScale"/>
                                <TranslateTransform x:Name="SelX"/>
                            </TransformGroup>
                        </Border.RenderTransform>
                    </Border>
                    <Border x:Name="InHandle" Width="18" Height="38" Canvas.Top="3" CornerRadius="6,0,0,6"
                            Background="{StaticResource AccentBrush}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Rectangle Width="2" Height="14" Fill="#1A0E08" RadiusX="1" RadiusY="1" Margin="1,0"/>
                            <Rectangle Width="2" Height="14" Fill="#1A0E08" RadiusX="1" RadiusY="1" Margin="1,0"/>
                        </StackPanel>
                        <Border.RenderTransform><TranslateTransform x:Name="InX"/></Border.RenderTransform>
                    </Border>
                    <Border x:Name="OutHandle" Width="18" Height="38" Canvas.Top="3" CornerRadius="0,6,6,0"
                            Background="{StaticResource AccentBrush}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Rectangle Width="2" Height="14" Fill="#1A0E08" RadiusX="1" RadiusY="1" Margin="1,0"/>
                            <Rectangle Width="2" Height="14" Fill="#1A0E08" RadiusX="1" RadiusY="1" Margin="1,0"/>
                        </StackPanel>
                        <Border.RenderTransform><TranslateTransform x:Name="OutX"/></Border.RenderTransform>
                    </Border>
                    <Grid x:Name="Playhead" Width="12" Height="44" Canvas.Top="0">
                        <Rectangle Width="2" Fill="White" RadiusX="1" RadiusY="1"/>
                        <Ellipse Width="10" Height="10" Fill="White" VerticalAlignment="Top"/>
                        <Grid.RenderTransform><TranslateTransform x:Name="PlayheadX"/></Grid.RenderTransform>
                    </Grid>
                </Canvas>
            </Grid>

            <!-- transport -->
            <DockPanel Margin="0,10,0,0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource Icon}" x:Name="VolIcon" Text="&#xE767;" FontSize="13" Margin="0,0,8,0"
                               Foreground="{StaticResource MutedBrush}" Cursor="Hand" MouseLeftButtonUp="VolIcon_Click"/>
                    <Slider x:Name="VolumeSlider" Width="96" Minimum="0" Maximum="1" Value="0.8" ValueChanged="Volume_Changed"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource ToolButton}" Click="Back5_Click" ToolTip="Back 5 s (Shift + ←)">
                        <TextBlock Text="−5s" FontSize="12" FontWeight="SemiBold"/>
                    </Button>
                    <Button x:Name="PlayButton" Style="{StaticResource PrimaryButton}" Width="44" Height="36" Padding="0"
                            Click="PlayPause_Click" ToolTip="Play / pause (Space)" Margin="4,0">
                        <TextBlock x:Name="PlayIcon" Style="{StaticResource Icon}" Text="&#xF5B0;" FontSize="14"/>
                    </Button>
                    <Button Style="{StaticResource ToolButton}" Click="Fwd5_Click" ToolTip="Forward 5 s (Shift + →)">
                        <TextBlock Text="+5s" FontSize="12" FontWeight="SemiBold"/>
                    </Button>
                    <TextBlock x:Name="TimeText" VerticalAlignment="Center" Margin="12,0,0,0" FontSize="12.5"
                               Typography.NumeralAlignment="Tabular" Text="0:00.0 / 0:00.0"/>
                    <Border Width="1" Height="20" Background="{StaticResource LineBrush}" Margin="16,0"/>
                    <Button Style="{StaticResource ToolButton}" Click="SetIn_Click" ToolTip="Start the clip here (I)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE8C6;" FontSize="12" Margin="0,0,6,0"/>
                            <TextBlock Text="Set start" FontSize="12"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolButton}" Click="SetOut_Click" ToolTip="End the clip here (O)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE8C6;" FontSize="12" Margin="0,0,6,0"/>
                            <TextBlock Text="Set end" FontSize="12"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolButton}" Click="ResetTrim_Click" ToolTip="Use the whole clip">
                        <TextBlock Text="Reset" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                    </Button>
                </StackPanel>
            </DockPanel>
        </StackPanel>

        <!-- ============ edit panel ============ -->
        <ScrollViewer Grid.Column="2" Grid.Row="1" Grid.RowSpan="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource Card}" Padding="18,16">
                    <StackPanel>
                        <TextBlock Text="Trim" Style="{StaticResource Eyebrow}"/>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Start" Foreground="{StaticResource FaintBrush}" FontSize="11"/>
                                <TextBlock x:Name="InText" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" Text="0:00.0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="End" Foreground="{StaticResource FaintBrush}" FontSize="11"/>
                                <TextBlock x:Name="OutText" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" Text="0:00.0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Length" Foreground="{StaticResource FaintBrush}" FontSize="11"/>
                                <TextBlock x:Name="LenText" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular"
                                           Foreground="{StaticResource AccentBrush}" Text="0:00.0"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Style="{StaticResource Muted}" FontSize="11.5" Margin="0,10,0,0"
                                   Text="Drag the orange handles, or press I / O to set start and end at the playhead."/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="18,16" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="Crop" Style="{StaticResource Eyebrow}" Margin="0,0,0,10"/>
                        <WrapPanel x:Name="CropPresets">
                            <RadioButton Style="{StaticResource Seg}" GroupName="Crop" Content="None" Tag="none" IsChecked="True" Checked="CropPreset_Checked"/>
                            <RadioButton Style="{StaticResource Seg}" GroupName="Crop" Content="Free" Tag="free" Checked="CropPreset_Checked"/>
                            <RadioButton Style="{StaticResource Seg}" GroupName="Crop" Content="16:9" Tag="16:9" Checked="CropPreset_Checked"/>
                            <RadioButton Style="{StaticResource Seg}" GroupName="Crop" Content="9:16" Tag="9:16" Checked="CropPreset_Checked"
                                         ToolTip="Vertical — TikTok, Shorts, Reels"/>
                            <RadioButton Style="{StaticResource Seg}" GroupName="Crop" Content="1:1" Tag="1:1" Checked="CropPreset_Checked"/>
                            <RadioButton Style="{StaticResource Seg}" GroupName="Crop" Content="4:3" Tag="4:3" Checked="CropPreset_Checked"/>
                        </WrapPanel>
                        <TextBlock x:Name="CropHint" Style="{StaticResource Muted}" FontSize="11.5" Margin="0,6,0,0"
                                   Text="Drag the box on the video to move it, or its corners to resize."/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="18,16" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="Audio" Style="{StaticResource Eyebrow}" Margin="0,0,0,10"/>
                        <StackPanel x:Name="ListenPanel" Visibility="Collapsed" Margin="0,0,0,12">
                            <TextBlock Text="Listen to" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,6"/>
                            <WrapPanel x:Name="ListenTracks"/>
                            <TextBlock x:Name="ListenStatus" Style="{StaticResource Muted}" FontSize="11" Margin="0,2,0,0"/>
                        </StackPanel>
                        <TextBlock x:Name="ExportAudioLabel" Text="When exporting" FontSize="12" Foreground="{StaticResource MutedBrush}"
                                   Margin="0,0,0,6" Visibility="Collapsed"/>
                        <ComboBox x:Name="AudioCombo" MinWidth="0">
                            <ComboBoxItem Content="Keep all tracks" Tag="all" IsSelected="True"/>
                            <ComboBoxItem Content="Mix only (one track)" Tag="mix"/>
                            <ComboBoxItem x:Name="AudioSelectedItem" Content="Tracks I'm listening to" Tag="selected" Visibility="Collapsed"/>
                            <ComboBoxItem Content="No audio" Tag="none"/>
                        </ComboBox>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="18,16" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="Export" Style="{StaticResource Eyebrow}" Margin="0,0,0,10"/>
                        <ComboBox x:Name="SaveModeCombo" MinWidth="0">
                            <ComboBoxItem Content="Save as a new file" Tag="new" IsSelected="True"/>
                            <ComboBoxItem Content="Replace the original" Tag="replace"/>
                        </ComboBox>
                        <DockPanel Margin="0,12,0,0">
                            <CheckBox x:Name="FastToggle" DockPanel.Dock="Right" Style="{StaticResource Switch}" Click="Fast_Click"/>
                            <StackPanel>
                                <TextBlock Text="Fast export" FontSize="13"/>
                                <TextBlock x:Name="FastDesc" Style="{StaticResource Muted}" FontSize="11.5" Margin="0,2,12,0"
                                           Text="Instant and lossless, but cuts snap to the nearest 2 s. Not available with crop."/>
                            </StackPanel>
                        </DockPanel>
                        <Button x:Name="ExportButton" Style="{StaticResource PrimaryButton}" Margin="0,14,0,0" Padding="14,10"
                                Click="Export_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE74E;" Margin="0,0,9,0"/>
                                <TextBlock x:Name="ExportText" Text="Export"/>
                            </StackPanel>
                        </Button>
                        <Grid x:Name="ExportProgress" Height="4" Margin="0,10,0,0" Visibility="Collapsed">
                            <Border CornerRadius="2" Background="{StaticResource Surface3Brush}"/>
                            <Border x:Name="ExportBar" CornerRadius="2" Background="{StaticResource AccentBrush}" HorizontalAlignment="Left" Width="0"/>
                        </Grid>
                        <TextBlock x:Name="ExportStatus" Style="{StaticResource Muted}" FontSize="11.5" Margin="0,8,0,0" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
