<Window x:Class="Savor.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ShowActivated="False" ResizeMode="NoResize"
        SizeToContent="WidthAndHeight" FontFamily="{StaticResource UiFont}"
        Opacity="0">
    <Border Margin="16" CornerRadius="12" Background="#F21E1F23" BorderBrush="#33353B" BorderThickness="1"
            Padding="14,12" Cursor="Hand" MouseLeftButtonUp="OnClick" MinWidth="280" MaxWidth="380">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.45" Color="Black"/>
        </Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border x:Name="Badge" Width="34" Height="34" CornerRadius="9" Background="{StaticResource AccentSoftBrush}"
                    VerticalAlignment="Center" Margin="0,0,12,0">
                <TextBlock x:Name="Glyph" Style="{StaticResource Icon}" Text="&#xE73E;" FontSize="16"
                           Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center"/>
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="TitleText" Foreground="{StaticResource TextBrush}" FontSize="13.5" FontWeight="SemiBold"/>
                <TextBlock x:Name="BodyText" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,2,0,0"
                           TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
